# Copy to .env - read by `npm run dev` / `npm start`.
# The Python seeders read the same PG*/MONGO_* variables (export them in your shell).
# --- API server ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ridesync_v2
PGUSER=postgres
PGPASSWORD=ridesync
# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=ridesync_db
